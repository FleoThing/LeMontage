# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/

# LeMontage runtime
output/
.lemontage/
models/
# …except the face detector weights that ship in the wheel (227 KB, MIT).
!src/lemontage/engine/models/

# Media artifacts (don't commit heavy media)
*.mp4
*.mov
*.mkv
*.mp3
*.wav
# yt-dlp writes these two, and their absence here is how a 2.5 MB download
# reached main (see the commit that added this line).
*.webm
*.m4a
!docs/**
!examples/**

# Local-only (internal — not for the public repo)
# AI-assistant working instructions
CLAUDE.md
# internal roadmap / launch plan
TODO.md
# working pipelines at the root (examples/ holds the public ones)
/pipeline*.yaml
# scratch workspaces from a `video-use` session: a source clip, an edit tree and
# its renders. The media inside is already ignored by extension, but an edit
# workspace is mostly *not* media — EDLs, transcripts, SRTs, verification
# screenshots — so it needs ignoring as a directory, not as a set of suffixes.
/videouse-test/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# local example assets (image carousel input)
/photos/
